<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Update / Now Bar countdown while a session runs (Android 16+) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- end the session on time even when the phone is idle; a timer app's core job -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- optional Do Not Disturb while focusing (the user grants access in settings) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the few seconds of session-end chime while off screen (Android mutes background audio) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Samsung: list Manbo under Live notifications so the countdown can sit in the Now Bar -->
    <uses-feature android:name="com.samsung.feature.nowbar" android:required="false" />

    <application
        android:label="Manbo"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">

        <meta-data android:name="com.samsung.android.support.ongoing_activity" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <service android:name=".ChimeService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
